{
  "$defs": {
    "DimensionResult": {
      "additionalProperties": false,
      "description": "Result of an evaluation dimension with cross-field consistency validation.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "skipped",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "detail": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Detail",
          "type": "object"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "n": {
          "default": 0,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "DimensionResult",
      "type": "object"
    },
    "RunMetadata": {
      "additionalProperties": false,
      "description": "Execution metadata stamped on every evaluation report.",
      "properties": {
        "corpus": {
          "title": "Corpus",
          "type": "string"
        },
        "run_date": {
          "title": "Run Date",
          "type": "string"
        },
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "generation_model": {
          "title": "Generation Model",
          "type": "string"
        },
        "embedding_model": {
          "title": "Embedding Model",
          "type": "string"
        },
        "judge_model": {
          "title": "Judge Model",
          "type": "string"
        },
        "judge_temperature": {
          "default": 0.0,
          "title": "Judge Temperature",
          "type": "number"
        },
        "judge_prompt_version": {
          "title": "Judge Prompt Version",
          "type": "string"
        },
        "sampling_seed": {
          "default": 42,
          "title": "Sampling Seed",
          "type": "integer"
        },
        "sample_size_deterministic": {
          "default": 0,
          "title": "Sample Size Deterministic",
          "type": "integer"
        },
        "sample_size_judged": {
          "default": 0,
          "title": "Sample Size Judged",
          "type": "integer"
        },
        "index_generation": {
          "title": "Index Generation",
          "type": "string"
        },
        "result_hash": {
          "title": "Result Hash",
          "type": "string"
        },
        "arm_labels": {
          "items": {
            "type": "string"
          },
          "title": "Arm Labels",
          "type": "array"
        },
        "dependency_lock_hash": {
          "title": "Dependency Lock Hash",
          "type": "string"
        },
        "partial": {
          "default": false,
          "title": "Partial",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "corpus",
        "run_date",
        "commit_sha",
        "generation_model",
        "embedding_model",
        "judge_model",
        "judge_prompt_version",
        "index_generation",
        "result_hash",
        "dependency_lock_hash"
      ],
      "title": "RunMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Scored evaluation report for a single corpus.",
  "properties": {
    "corpus": {
      "title": "Corpus",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/RunMetadata"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/DimensionResult"
      },
      "title": "Dimensions",
      "type": "array"
    }
  },
  "required": [
    "corpus",
    "metadata"
  ],
  "title": "CorpusReport",
  "type": "object"
}
