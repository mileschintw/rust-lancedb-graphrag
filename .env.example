# Lancet quickstart environment (copy to .env, which is gitignored, and fill in the key).
#
# There is no dotenv loader: nothing reads this file by itself. Export it into the
# shell that starts the engine, the gateway and the eval helper (the README quickstart
# has a bash and a PowerShell snippet). Every new terminal repeats the export.
#
# The only value you supply is the OpenRouter key. The two values below it are the
# committed local-dev defaults; the Postgres credentials (postgres/postgres) and the
# Grafana login (admin/admin) are local-dev values that are committed on purpose, not
# secrets.

# OpenRouter API key, used by the engine for embeddings, generation and rerank.
OPENROUTER_API_KEY=

# Gateway Postgres connection (the compose database on loopback).
LANCET_GATEWAY__DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lancet?sslmode=disable

# Where the eval helper and lancet-eval find the gateway. 127.0.0.1 rather than
# localhost avoids a Windows IPv6 resolution stall.
LANCET_EVAL__GATEWAY_URL=http://127.0.0.1:8080
